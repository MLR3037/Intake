# Copy this file to .env.local and fill in your organization's real values.
# .env.local is gitignored and never committed.

# Azure AD app registration
VITE_SP_CLIENT_ID=
VITE_SP_TENANT_ID=

# Redirect URI must be registered as a SPA platform redirect URI on the Azure app.
VITE_SP_REDIRECT_URI=http://localhost:5173

# Main SharePoint site (used for authentication and legacy client data).
VITE_SP_SITE_URL=

# Staff source: HR current employees list.
VITE_SP_STAFF_SITE_URL=
VITE_SP_STAFF_LIST=

# Current clients list.
VITE_SP_CURRENT_CLIENTS_SITE_URL=
VITE_SP_CURRENT_CLIENTS_LIST=

# Discharged clients list - defaults to the current clients site/list above if not set.
VITE_SP_DISCHARGED_CLIENTS_SITE_URL=
VITE_SP_DISCHARGED_CLIENTS_LIST=

# Intake/prospective clients list.
VITE_SP_INTAKE_SITE_URL=
VITE_SP_INTAKE_LIST=

# Capacity planning list.
VITE_SP_CAPACITY_SITE_URL=
VITE_SP_CAPACITY_LIST=

# HR onboarding list.
VITE_SP_HR_SITE_URL=
VITE_SP_NEW_HIRE_LIST=

# Discharged staff list - defaults to the main site above if not set.
VITE_SP_DISCHARGED_STAFF_SITE_URL=
VITE_SP_DISCHARGED_STAFF_LIST=
